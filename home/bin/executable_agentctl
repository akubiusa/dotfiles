#!/bin/bash
# agentctl: 自律 AI agent runtime keeper CLI entrypoint。
#
# runtime keeper の不変条件:
#   - keeper は Git/worktree/merge lifecycle を一切所有しない (git/gh を呼ばない)。
#   - mission/steer 本文は argv/state/event に残さない (file/stdin のみ)。
#   - runtime_id + caller expected token による fencing で stale command を拒否する。
#
# 実装範囲: start/status/logs/steer/attach/interrupt/stop/cleanup/resume/complete/doctor。
# backend は fake/claude/claude-work/codex を実装済み
# (agentctl-backend-claude.sh / agentctl-backend-codex.sh)。

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck disable=SC1091
source "$SCRIPT_DIR/agentctl-common.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/agentctl-backend-claude.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/agentctl-backend-codex.sh"

AGENTCTL_SCHEMA_VERSION=1

usage() {
  cat <<'EOF'
usage: agentctl <command> <name> [options]

commands:
  start     <name> --agent <fake|claude|claude-work|codex> --cwd DIR --policy-file FILE
            (--mission-file FILE | --mission-stdin)
  status    <name> [--json]
  logs      <name> [--lines N] [--follow]
  steer     <name> --runtime-id ID (--file FILE | --stdin) [--json]
  attach    <name> --runtime-id ID
  interrupt <name> --runtime-id ID
  stop      <name> --runtime-id ID
  cleanup   <name> --runtime-id ID
  resume    <name> --from-runtime-id ID [--policy-file FILE]
  complete  <name> --runtime-id ID
  doctor    [--json]

<name> may also be given as --name NAME (compat alias). --backend is a
compat alias for --agent. resume always inherits --cwd/--agent from the
predecessor generation's state; passing --cwd/--agent/--backend to resume
is a usage error.
EOF
}

require_arg() {
  local flag="$1" value="${2:-}"
  [ -n "$value" ] || agentctl_die "missing required argument: $flag"
}

require_option_value() {
  local flag="$1" remaining_argc="$2"
  [ "$remaining_argc" -ge 2 ] || agentctl_die "missing value for option: $flag"
}

# --- start 処理 -----------------------------------------------------------

cmd_start() {
  local name="" cwd="" backend="" policy_file="" mission_file="" mission_stdin=0
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --cwd) require_option_value "$1" "$#"; cwd="$2"; shift 2 ;;
      --backend|--agent) require_option_value "$1" "$#"; backend="$2"; shift 2 ;;
      --policy-file) require_option_value "$1" "$#"; policy_file="$2"; shift 2 ;;
      --mission-file) require_option_value "$1" "$#"; mission_file="$2"; shift 2 ;;
      --mission-stdin) mission_stdin=1; shift ;;
      *) agentctl_die "unknown option for start: $1" ;;
    esac
  done

  require_arg --name "$name"
  require_arg --cwd "$cwd"
  require_arg --backend "$backend"
  require_arg --policy-file "$policy_file"

  agentctl_validate_name "$name"

  [[ "$cwd" == /* ]] || agentctl_die "--cwd must be an absolute path"
  [ -d "$cwd" ] || agentctl_die "--cwd does not exist: $cwd"

  if [ -n "$mission_file" ] && [ "$mission_stdin" -eq 1 ]; then
    agentctl_die "specify exactly one of --mission-file or --mission-stdin"
  fi
  if [ -z "$mission_file" ] && [ "$mission_stdin" -eq 0 ]; then
    agentctl_die "mission input is required: --mission-file or --mission-stdin"
  fi
  if [ -n "$mission_file" ]; then
    [ -f "$mission_file" ] || agentctl_die "--mission-file not found: $mission_file"
  fi

  case "$backend" in
    fake|claude|claude-work|codex) : ;;
    *) agentctl_die "unknown backend: $backend" ;;
  esac

  local policy_json
  policy_json=$(agentctl_validate_policy_file "$policy_file")

  agentctl_ensure_root
  agentctl_with_name_lock "$name" _start_locked "$name" "$cwd" "$backend" "$policy_file" "$policy_json" "$mission_file" "$mission_stdin"
}

_start_locked() {
  local name="$1" cwd="$2" backend="$3" policy_file="$4" policy_json="$5" mission_file="$6" mission_stdin="$7"

  local existing
  existing=$(agentctl_reconcile "$name")
  case "$existing" in
    absent) : ;;
    running|starting) agentctl_die --code 4 "runtime '$name' is already $existing; use steer or stop first" ;;
    *) agentctl_die --code 4 "runtime '$name' is in '$existing' state; run 'agentctl cleanup --name $name --runtime-id <id>' first" ;;
  esac

  local dir
  dir=$(agentctl_runtime_dir "$name")
  mkdir -p "$dir"
  chmod 0700 "$dir"

  # mission 本文を argv に残さず file へ格納する。
  local mission_path="$dir/mission.txt"
  if [ "$mission_stdin" -eq 1 ]; then
    cat | agentctl_atomic_write "$mission_path" 0600
  else
    agentctl_atomic_write "$mission_path" 0600 <"$mission_file"
  fi

  # policy snapshot: source file 変更後も effective policy が変わらないよう canonical JSON を固定する。
  # content-addressed path (policy.snapshot.<sha256>.json) にすることで、
  # 将来の resume が別の policy を渡してもこの generation の snapshot を
  # 上書きできず、前 generation の effective policy を immutable に保つ。
  local policy_snapshot_path policy_digest
  {
    IFS= read -r policy_snapshot_path
    IFS= read -r policy_digest
  } < <(agentctl_write_policy_snapshot "$dir" "$policy_json")

  agentctl_write_initial_manifest "$name" "$cwd"

  _publish_generation "$name" "$cwd" "$backend" "$policy_snapshot_path" "$policy_digest" "" "start"
}

# guard sentinel 検証に失敗した generation を rollback する。owned session の
# termination が成功するまでは binding/state を残し、live backend を unguarded にしない。
_rollback_failed_guard_generation() {
  local backend="$1" session="$2" name="$3" runtime_id="$4" predecessor_state_json="$5"

  agentctl_tmux kill-session -t "$session" 2>/dev/null \
    || agentctl_die --code 5 "guard sentinel verification failed and owned tmux session could not be terminated; preserving runtime state/bindings for '$name'"

  [ "$backend" != "codex" ] || agentctl_codex_hook_remove_runtime_bindings "$runtime_id"
  if [ -n "$predecessor_state_json" ]; then
    printf '%s\n' "$predecessor_state_json" | agentctl_write_state_json "$name"
  else
    rm -f "$(agentctl_state_file "$name")"
  fi
}

# 新規 generation を publish する (start / resume 共通)。
# spec の runtime publication barrier (starting state -> blocked bootstrap ->
# owner marker -> release token) をここに一本化する。stdout に runtime_id を返す。
# prelude_path が非空なら (resume の continuation bundle、元の mission 本文を
# 内包済み)、mission.txt の代わりにそれを 1 turn として fresh backend へ届ける。
_publish_generation() {
  local name="$1" cwd="$2" backend="$3" policy_snapshot_path="$4" policy_digest="$5" prelude_path="$6" operation_name="${7:-start}"
  local dir manifest_path
  dir=$(agentctl_runtime_dir "$name")
  manifest_path="$dir/manifest.json"

  # guard sentinel 検証 (後述) が失敗した際に、resume で既に publish 済みの
  # predecessor generation の state.json を元に戻せるよう、上書きする前の
  # 内容を保持しておく (fresh start では predecessor が無いので空のまま)。
  local predecessor_state_json=""
  predecessor_state_json=$(agentctl_read_state "$name" 2>/dev/null) || predecessor_state_json=""

  local runtime_id started_at session
  runtime_id=$(agentctl_gen_runtime_id)
  started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  session=$(agentctl_tmux_session "$name")

  # 0. deployment global shared lock を guard/backend preflight より前、かつ
  #    publication 完了まで保持する。preflight だけを先に済ませて lock 外で
  #    実行すると、preflight 成功直後に exclusive rollback が割り込んで依存を
  #    除去し、その stale な preflight 判定のまま publish してしまう TOCTOU が
  #    生じるため (rollback の exclusive lock と start/resume の shared lock は
  #    同じ deployment lockfile を取り合うので、shared 区間に入った時点で
  #    rollback は完了まで一切割り込めない)。
  agentctl_acquire_deployment_lock_shared

  agentctl_maybe_test_barrier post_lock_pre_preflight

  # 1. guard/backend preflight は shared lock 取得後、state/tmux に一切触れる前に
  #    行う (fake backend は no-op preflight)。guard 配線が壊れている/依存が
  #    消えている状態で start/resume しても "starting" state や blocked
  #    bootstrap session を publish してしまわないようにする。preflight失敗時は
  #    runtime generation 自体を一切 publish しない。
  local backend_cmd
  if [ "$backend" = "fake" ]; then
    # local_write=false は機械的な read-only mode で強制する必要がある
    # 機械的 read-only mode を構成できない backend は read-only policy で起動しない。
    # fake backend にはその仕組みが無いため、local_write=false なら start 自体を拒否する。
    local local_write
    local_write=$(jq -r '.permissions.local_write' "$policy_snapshot_path")
    if [ "$local_write" != "true" ]; then
      agentctl_die --code 4 "fake backend cannot enforce local_write=false (no mechanical read-only mode); refusing start"
    fi
    # 既定コマンドは stty raw で pty の canonical line-buffering を外す。
    # 実インタラクティブ backend (Claude/Codex TUI) はいずれも raw mode で
    # 端末を読むため、最終行が改行なしでも即時読み取れる挙動に合わせる。
    # sink は O_APPEND ではなく単一の長命 fd で開く (O_APPEND だと pty 上の
    # 2 回目以降の paste-buffer 由来データを失い得るため使わない)。
    # cat ではなく tee を使い、受信内容を sink file に加えて自身の stdout
    # (= pane 画面) にも複製する。これにより `agentctl logs` が pane capture
    # 経由で実際の受信内容を観測できる (cat のみだと画面には何も描画されない)。
    backend_cmd="stty raw -echo; tee \"$dir/fake-sink.txt\""
  elif [ "$backend" = "claude" ] || [ "$backend" = "claude-work" ]; then
    backend_cmd=$(agentctl_backend_claude_command "$backend" "$policy_snapshot_path" "$dir") \
      || agentctl_die --code 5 "claude backend guard preflight failed"
  elif [ "$backend" = "codex" ]; then
    backend_cmd=$(agentctl_backend_codex_command "$policy_snapshot_path" "$dir") \
      || agentctl_die --code 5 "codex backend guard preflight failed"
  fi

  # 2. starting state を publish 前に書く。
  jq -n \
    --argjson schema_version "$AGENTCTL_SCHEMA_VERSION" \
    --arg name "$name" --arg backend "$backend" --arg runtime_id "$runtime_id" \
    --arg cwd "$cwd" --arg tmux_session "$session" --arg started_at "$started_at" \
    --arg policy_snapshot_path "$policy_snapshot_path" --arg policy_digest "$policy_digest" \
    '{schema_version:$schema_version, name:$name, backend:$backend, runtime_id:$runtime_id,
      cwd:$cwd, tmux_session:$tmux_session, pane_id:null, pane_pid:null, pane_pid_start:null,
      started_at:$started_at, policy_snapshot_path:$policy_snapshot_path, policy_digest:$policy_digest,
      status:"starting"}' | agentctl_write_state_json "$name"

  agentctl_maybe_fault pre_tmux

  # tmux セッションが既に (無関係に) 存在する可能性は reconcile 確認で除外済みだが、念のため。
  if agentctl_tmux_has_session "$session"; then
    agentctl_die --code 4 "tmux session '$session' unexpectedly exists"
  fi

  # 3. blocked bootstrap: 実 backend ではなく一時保持プロセスを起動する。
  # release token (respawn-pane) が届かない launcher crash では bootstrap 自身が
  # bounded timeout で終了し、未所有 live process を無期限に残さない。
  local bootstrap_timeout="${AGENTCTL_TEST_BOOTSTRAP_TIMEOUT_SECONDS:-300}"
  agentctl_tmux new-session -d -s "$session" -c "$cwd" -- \
    bash -c "trap '' TERM INT; sleep $bootstrap_timeout"
  agentctl_tmux set-option -t "$session" remain-on-exit on >/dev/null

  agentctl_maybe_fault pre_marker

  # 実 pane_id (%N) を解決し、以降はこれを canonical な target として使う
  # (session:0 決め打ちは base-index が 0 以外の tmux.conf で壊れるため避ける)。
  local pane
  pane=$(agentctl_tmux_pane_id "$session")
  [ -n "$pane" ] || agentctl_die --code 5 "failed to resolve pane_id after tmux new-session"
  local pane_pid pane_pid_start
  pane_pid=$(agentctl_tmux_pane_pid "$pane")
  pane_pid_start=$(agentctl_pid_start_token "$pane_pid")

  # 4. owner/runtime marker を publish する。
  agentctl_tmux_set_marker "$pane" owner "agentctl"
  agentctl_tmux_set_marker "$pane" name "$name"
  agentctl_tmux_set_marker "$pane" backend "$backend"
  agentctl_tmux_set_marker "$pane" runtime_id "$runtime_id"
  agentctl_tmux_set_marker "$pane" schema_version "$AGENTCTL_SCHEMA_VERSION"

  agentctl_maybe_fault post_marker_pre_release

  # 5. state/pane evidence 相互照合 (marker を読み直して一致を確認する)。
  local check_owner check_runtime_id
  check_owner=$(agentctl_tmux_get_marker "$pane" owner)
  check_runtime_id=$(agentctl_tmux_get_marker "$pane" runtime_id)
  if [ "$check_owner" != "agentctl" ] || [ "$check_runtime_id" != "$runtime_id" ]; then
    agentctl_die --code 4 "marker cross-check failed after publication"
  fi

  # 7. release token: pane を respawn し、bootstrap holder を実 backend command に置き換える。
  #    これが一度きりの publication 完了アクションである。runtime_id/policy snapshot は
  #    backend guard (Codex dispatcher 等) が読む env として渡す。
  agentctl_tmux respawn-pane -k -t "$pane" -c "$cwd" -- env \
    "AGENTCTL_RUNTIME_ID=$runtime_id" \
    "AGENTCTL_POLICY_SNAPSHOT=$policy_snapshot_path" \
    "AGENTCTL_POLICY_DIGEST=$policy_digest" \
    "AGENTCTL_MISSION_MANIFEST=$manifest_path" \
    bash -c "$backend_cmd"

  # 7a. 実 backend の readline が armed になるまで待つ (fake は即 return)。
  #     起動直後に paste+Enter すると Enter だけ失われ、後続 steer の paste+
  #     Enter が未 submit の initial mission と連結されて誤実行される race が
  #     起こり得るため、mission delivery の前に必ずこの barrier を通す。
  agentctl_wait_backend_ready "$backend" "$pane" "$dir"

  # Codex interactive TUI の hook subprocess は respawn-pane の AGENTCTL_* env を
  # 継承しない。real sentinel turn の直前だけ HOME 固定 registry に、この generation
  # の absolute runtime/policy context を pending publish する。sentinel hook 自身が
  # marker の runtime_id + stable session_id を照合して session binding へ consume する。
  local sentinel_nonce=""
  if [ "$backend" = "codex" ]; then
    sentinel_nonce=$(agentctl_gen_runtime_id)
    agentctl_codex_hook_publish_pending "$name" "$runtime_id" "$dir" "$policy_snapshot_path" "$policy_digest" "$cwd" "$sentinel_nonce"
  fi

  # 7a-2. guard startup verification: settings JSON を書いた/dispatcher
  #       を直接呼んだだけでは実 backend process が hook を実際に load した
  #       証拠にならない。無害な sentinel command を実 turn 経由で走らせ、
  #       PreToolUse dispatcher が deny evidence を書くことを機械的に確認する
  #       まで、mission delivery も "running" への publish も行わない。証拠が
  #       得られなければ、この generation は一切生きた痕跡を残さず fail
  #       closed する (predecessor が存在するなら元の state.json へ復元する)。
  if [ "$backend" != "fake" ]; then
    if ! agentctl_verify_guard_sentinel "$backend" "$pane" "$dir" "$runtime_id" "$sentinel_nonce"; then
      _rollback_failed_guard_generation "$backend" "$session" "$name" "$runtime_id" "$predecessor_state_json"
      agentctl_die --code 5 "guard sentinel verification failed for backend '$backend': could not obtain mechanical proof that the PreToolUse guard is active (no runtime published)"
    fi
    # 現行 interactive TUI では sentinel hook が pending を consume する。将来
    # ambient env が再び継承される実装へ変わっても stale pending を残さない。
    [ "$backend" != "codex" ] || agentctl_codex_hook_remove_pending "$runtime_id"
  fi

  # 7b. mission (task-specific + common contract) を backend へ渡す。ChatGPT 等の
  #     外部仲介なしに自律開始させる v8 の目的上、start/resume は必ずここで初期
  #     mission を pty へ届ける。argv/env に本文を残さないため、steer (行 340
  #     付近) と同じ tmux buffer 経由の転送を使う (-r で \n->\r 変換を無効化し
  #     2000 字超/multiline/日本語を byte-safe に届ける)。
  #     paste 直後に submit (実 backend のみ) して、TUI 入力欄に滞留させず
  #     ChatGPT 等の手動操作なしで実行を開始させる。
  # prelude_path (resume の continuation bundle) が渡された場合は、元の
  # mission 本文をその中に埋め込んだ 1 ファイルとして届けるため、mission.txt
  # を別 turn として重ねて送らない (paste+screen-settle には turn 完了を
  # 確認する barrier が無く、2 回に分けると実 backend 上で 1 turn 目実行中の
  # steer と区別できず衝突し得るため)。
  if [ -n "$prelude_path" ]; then
    agentctl_deliver_body "$backend" "$pane" "$dir" "$prelude_path" "$runtime_id" "$operation_name" \
      || agentctl_die --code 5 "failed to deliver continuation bundle to backend '$backend' (publication left at status=starting)"
  else
    local mission_path="$dir/mission.txt"
    if [ -f "$mission_path" ]; then
      # mission.txt 自体は resume での再利用に備え生の task mission のまま
      # 保つ。common contract との合成は配信専用の別 file (mission-delivery.txt)
      # で行い、1 turn として届ける (build_continuation_bundle と同じく
      # mission 本文だけは `cat --` で stream し、command substitution による
      # 末尾改行欠落を避ける)。
      local delivery_path="$dir/mission-delivery.txt"
      {
        agentctl_common_mission_contract
        echo
        echo "=== TASK MISSION ==="
        cat -- "$mission_path"
      } | agentctl_atomic_write "$delivery_path" 0600
      agentctl_deliver_body "$backend" "$pane" "$dir" "$delivery_path" "$runtime_id" "$operation_name" \
        || agentctl_die --code 5 "failed to deliver initial mission to backend '$backend' (publication left at status=starting)"
    fi
  fi

  agentctl_maybe_fault post_release

  # respawn-pane はプロセスを差し替えるため、記録する pane_pid/start token は
  # respawn 後に取り直す (bootstrap holder の PID を記録すると PID 再利用
  # フェンシングが機能しない)。
  pane_pid=$(agentctl_tmux_pane_pid "$pane")
  pane_pid_start=$(agentctl_pid_start_token "$pane_pid")

  jq -n \
    --argjson schema_version "$AGENTCTL_SCHEMA_VERSION" \
    --arg name "$name" --arg backend "$backend" --arg runtime_id "$runtime_id" \
    --arg cwd "$cwd" --arg tmux_session "$session" --arg pane_id "$pane" \
    --argjson pane_pid "$pane_pid" --arg pane_pid_start "$pane_pid_start" \
    --arg started_at "$started_at" \
    --arg policy_snapshot_path "$policy_snapshot_path" --arg policy_digest "$policy_digest" \
    '{schema_version:$schema_version, name:$name, backend:$backend, runtime_id:$runtime_id,
      cwd:$cwd, tmux_session:$tmux_session, pane_id:$pane_id, pane_pid:$pane_pid, pane_pid_start:$pane_pid_start,
      started_at:$started_at, policy_snapshot_path:$policy_snapshot_path, policy_digest:$policy_digest,
      status:"running"}' | agentctl_write_state_json "$name"

  agentctl_release_deployment_lock

  echo "$runtime_id"
}

# --- status 処理 -----------------------------------------------------------

cmd_status() {
  local name="" json=0
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) agentctl_die "unknown option for status: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"

  local reconcile state_json
  reconcile=$(agentctl_reconcile "$name")
  if state_json=$(agentctl_read_state "$name" 2>/dev/null); then
    :
  else
    state_json='null'
  fi

  local out
  out=$(jq -n --argjson schema_version "$AGENTCTL_SCHEMA_VERSION" --arg reconcile "$reconcile" \
    --argjson state "$state_json" \
    '{schema_version:$schema_version, reconcile:$reconcile,
      runtime_id: ($state.runtime_id // null), name: ($state.name // null),
      backend: ($state.backend // null), started_at: ($state.started_at // null)}')

  if [ "$json" -eq 1 ]; then
    echo "$out"
  else
    echo "$out" | jq -r '"name=\(.name // "-") reconcile=\(.reconcile) runtime_id=\(.runtime_id // "-") backend=\(.backend // "-")"'
  fi
}

# --- steer 処理 -----------------------------------------------------------

cmd_steer() {
  local name="" runtime_id="" file="" use_stdin=0 json=0
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      --file) require_option_value "$1" "$#"; file="$2"; shift 2 ;;
      --stdin) use_stdin=1; shift ;;
      --json) json=1; shift ;;
      *) agentctl_die "unknown option for steer: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"
  if [ -n "$file" ] && [ "$use_stdin" -eq 1 ]; then
    agentctl_die "specify exactly one of --file or --stdin"
  fi
  if [ -z "$file" ] && [ "$use_stdin" -eq 0 ]; then
    agentctl_die "steer body is required: --file or --stdin"
  fi

  local tmpfile=""
  if [ "$use_stdin" -eq 1 ]; then
    tmpfile=$(mktemp)
    # set -e 下では失敗した bare statement でスクリプトが即終了し、後続の rm が
    # 実行されない (steer body を含む temp file が残る)。trap で経路によらず消す。
    # trap は関数の local scope 外 (script 終了時) に実行されるため、$tmpfile は
    # ここで即時展開する (シングルクォートの遅延展開だと unbound variable になる)。
    # shellcheck disable=SC2064
    trap "rm -f '$tmpfile'" EXIT
    cat >"$tmpfile"
    file="$tmpfile"
  fi

  agentctl_with_name_lock "$name" _steer_locked "$name" "$runtime_id" "$file" "$json"
}

# steer の機械可読な結果契約: result は accepted|submitted|unknown のいずれか
# (本文/payload は一切含まない)。screen heuristic からは絶対に "accepted" を
# 返さない (native transport が turn ID 等で確証を得られる場合のみ将来値を
# 追加する)。paste+submit がタイムアウトし acceptance が不確定な場合も
# generic な失敗として exit するのではなく result="unknown" を明示し、
# 呼び出し元に「再送してよい」と誤解させない。
_steer_locked() {
  local name="$1" runtime_id="$2" file="$3" json="$4"
  local reconcile state_json current_id
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    running) : ;;
    absent) agentctl_die --code 3 "runtime '$name' is not running (reconcile=absent)" ;;
    *) agentctl_die --code 4 "runtime '$name' is not running (reconcile=$reconcile)" ;;
  esac
  state_json=$(agentctl_read_state "$name") || agentctl_die --code 3 "no state for '$name'"
  current_id=$(echo "$state_json" | jq -r '.runtime_id')
  [ "$runtime_id" = "$current_id" ] || agentctl_die --code 4 "stale --runtime-id (expected current generation $current_id)"

  local session pane backend dir
  session=$(echo "$state_json" | jq -r '.tmux_session')
  backend=$(echo "$state_json" | jq -r '.backend')
  pane="${session}"
  dir=$(agentctl_runtime_dir "$name")
  # 本文をバッファ名/argv に残さず tmux buffer 経由で投入する (codex は本文
  # そのものを paste せず operation-specific secure copy の bootstrap を送る)。
  # agentctl_deliver_body の唯一の失敗経路は paste 後の screen-settle timeout
  # であり、これは常に delivery 後 (paste 自体は既に発生済み) の不確定状態
  # (result=unknown) を意味する。delivery 後の unknown
  # は再送を誘発しないため non-destructive success として exit 0 のまま扱う
  # (delivery 前の確定 failure は上の agentctl_die --code 4 で既に typed
  # non-zero exit している)。
  local deliver_rc=0
  agentctl_deliver_body "$backend" "$pane" "$dir" "$file" "$runtime_id" "steer" || deliver_rc=$?
  case "$deliver_rc" in
    0) : ;;
    1)
      # paste-buffer 呼出し後の不確定 failure。再送を誘発しないよう unknown/exit 0。
      [ "${AGENTCTL_DELIVER_RESULT:-}" = "unknown" ] \
        || agentctl_die --code 5 "steer transport failed with an unclassified post-delivery result"
      ;;
    5)
      agentctl_die --code 5 "steer transport failed before delivery"
      ;;
    *)
      agentctl_die --code 5 "steer transport failed with unexpected status $deliver_rc"
      ;;
  esac

  if [ "$json" -eq 1 ]; then
    jq -n \
      --arg result "$AGENTCTL_DELIVER_RESULT" --arg operation_id "$AGENTCTL_DELIVER_OPERATION_ID" \
      --arg runtime_id "$runtime_id" --arg transport "$AGENTCTL_DELIVER_TRANSPORT" \
      '{result:$result, operation_id:$operation_id, runtime_id:$runtime_id, transport:$transport}'
  else
    echo "$AGENTCTL_DELIVER_RESULT"
  fi
}

# --- logs 処理 -----------------------------------------------------------

cmd_logs() {
  local name="" lines=200 follow=0
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --lines) require_option_value "$1" "$#"; lines="$2"; shift 2 ;;
      --follow) follow=1; shift ;;
      *) agentctl_die "unknown option for logs: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  case "$lines" in
    ''|*[!0-9]*) agentctl_die "--lines must be a positive integer" ;;
  esac

  # logs は読み取り専用のため per-name lock は取らない (status/doctor と同じ)。
  # ownership は reconcile state で判定する: 所有 tmux generation が無い
  # (stale/absent)、または evidence が矛盾する (conflict) 場合は拒否する。
  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    running|starting|exited|orphan) : ;;
    conflict) agentctl_die --code 4 "runtime '$name' is in conflict state; refusing to read logs (manual inspection required)" ;;
    stale|absent) agentctl_die --code 3 "no runtime log available for '$name' (reconcile=$reconcile)" ;;
    *) agentctl_die --code 4 "runtime '$name' is in unrecognized state '$reconcile'; refusing logs" ;;
  esac

  local pane
  pane=$(agentctl_tmux_session "$name")
  if [ "$follow" -eq 1 ]; then
    _logs_follow "$pane"
  else
    agentctl_tmux capture-pane -p -J -t "$pane" -S "-$lines"
  fi
}

# pane 全体を毎回再取得し前回との差分だけ出力する素朴な poll loop。
# follow client を kill/detach しても読み取り専用のため runtime へは一切
# 影響しない。follow client の切断を runtime の EOF/signal に変換しない。
# tmux pipe-pane は効率的だが、pane に恒久的な hook を残し
# 他操作 (respawn-pane 等) と干渉し得るため、この規模の log 量では素朴な
# 差分 poll で十分とする。
_logs_follow() {
  local pane="$1" prev=""
  while agentctl_tmux_has_session "$pane"; do
    local cur
    cur=$(agentctl_tmux capture-pane -p -J -t "$pane" -S - 2>/dev/null) || break
    if [ "$cur" != "$prev" ]; then
      if [ -n "$prev" ] && [ "${cur:0:${#prev}}" = "$prev" ]; then
        printf '%s' "${cur:${#prev}}"
      else
        printf '%s' "$cur"
      fi
      prev="$cur"
    fi
    sleep "${AGENTCTL_TEST_LOGS_FOLLOW_INTERVAL_SECONDS:-1}"
  done
}

# --- attach 処理 -----------------------------------------------------------

cmd_attach() {
  local name="" runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for attach: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"

  # name lock 内で generation と exact tmux pane/session identity を採取する。
  # attach 中ずっと lock を保持すると observer が steer/stop を阻害するため、lock は
  # ここで解放する。その代わり attach 直前に tmux server 内の単一 command queue で
  # old pane + runtime marker を再照合し、同名 new generation への name reuse を防ぐ。
  local attach_evidence session_id pane
  attach_evidence=$(agentctl_with_name_lock "$name" _attach_check "$name" "$runtime_id")
  IFS=$'\t' read -r session_id pane <<<"$attach_evidence"
  [ -n "$session_id" ] && [ -n "$pane" ] \
    || agentctl_die --code 4 "failed to resolve exact tmux identity for runtime '$name'"
  agentctl_attach_fenced "$session_id" "$pane" "$runtime_id"
}

_attach_check() {
  local name="$1" runtime_id="$2"
  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    running|starting) : ;;
    absent) agentctl_die --code 3 "runtime '$name' is not running (reconcile=absent)" ;;
    *) agentctl_die --code 4 "runtime '$name' is not running (reconcile=$reconcile)" ;;
  esac
  local state_json current_id session pane session_id
  state_json=$(agentctl_read_state "$name") || agentctl_die --code 3 "no state for '$name'"
  current_id=$(echo "$state_json" | jq -r '.runtime_id')
  [ "$runtime_id" = "$current_id" ] || agentctl_die --code 4 "stale --runtime-id (expected current generation $current_id)"
  session=$(agentctl_tmux_session "$name")
  pane=$(agentctl_tmux_pane_id "$session")
  [ -n "$pane" ] || agentctl_die --code 4 "runtime '$name' has no current tmux pane"
  session_id=$(agentctl_tmux display-message -p -t "$pane" '#{session_id}' 2>/dev/null) \
    || agentctl_die --code 4 "runtime '$name' tmux session disappeared during attach fencing"
  [[ "$session_id" =~ ^\$[0-9]+$ ]] || agentctl_die --code 4 "runtime '$name' has invalid tmux session identity"
  printf '%s\t%s\n' "$session_id" "$pane"
}

agentctl_attach_fenced() {
  local session_id="$1" pane="$2" runtime_id="$3" condition
  [[ "$session_id" =~ ^\$[0-9]+$ ]] || agentctl_die --code 4 "invalid tmux session identity for attach"
  [[ "$pane" =~ ^%[0-9]+$ ]] || agentctl_die --code 4 "invalid tmux pane identity for attach"
  [[ "$runtime_id" =~ ^[A-Za-z0-9_-]+$ ]] || agentctl_die --code 4 "invalid runtime_id for attach"

  # `if-shell -F` は format 判定と true/false command を同じ tmux server command queue
  # で処理する。pane が消失/再作成された場合や marker が別 generation なら false
  # branch が non-zero を返し、session name を再解決して new generation へ attach しない。
  condition="#{&&:#{==:#{pane_id},$pane},#{&&:#{==:#{@agentctl_owner},agentctl},#{==:#{@agentctl_runtime_id},$runtime_id}}}"
  agentctl_tmux if-shell -F -t "$pane" "$condition" \
    "attach-session -t '$session_id'" "run-shell 'exit 74'" \
    || agentctl_die --code 4 "runtime generation changed before attach; refusing stale client"
}

# --- interrupt 処理 -----------------------------------------------------------

cmd_interrupt() {
  local name="" runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for interrupt: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"
  agentctl_with_name_lock "$name" _interrupt_locked "$name" "$runtime_id"
}

_interrupt_locked() {
  local name="$1" runtime_id="$2"
  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    running) : ;;
    absent) agentctl_die --code 3 "runtime '$name' is not running (reconcile=absent)" ;;
    *) agentctl_die --code 4 "runtime '$name' is not running (reconcile=$reconcile)" ;;
  esac
  local state_json current_id
  state_json=$(agentctl_read_state "$name") || agentctl_die --code 3 "no state for '$name'"
  current_id=$(echo "$state_json" | jq -r '.runtime_id')
  [ "$runtime_id" = "$current_id" ] || agentctl_die --code 4 "stale --runtime-id (expected current generation $current_id)"

  local pane
  pane=$(echo "$state_json" | jq -r '.tmux_session')
  # OS kill signal ではなく tty keystroke (Ctrl-C) として送る。backend
  # (raw mode TUI) 自身が turn interrupt として解釈するのに任せ、
  # process/pane を強制終了しない (状態を破壊しない安全な interrupt)。
  agentctl_tmux send-keys -t "$pane" C-c
  echo "interrupted"
}

# --- stop 処理 -----------------------------------------------------------

cmd_stop() {
  local name="" runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for stop: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"
  agentctl_with_name_lock "$name" _stop_locked "$name" "$runtime_id"
}

_stop_locked() {
  local name="$1" runtime_id="$2"
  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    absent|stale|exited) echo "already stopped (reconcile=$reconcile)"; return 0 ;;
    running|starting) : ;;
    *) agentctl_die --code 4 "cannot stop runtime '$name' in state '$reconcile'" ;;
  esac
  local state_json current_id session
  state_json=$(agentctl_read_state "$name") || agentctl_die --code 3 "no state for '$name'"
  current_id=$(echo "$state_json" | jq -r '.runtime_id')
  [ "$runtime_id" = "$current_id" ] || agentctl_die --code 4 "stale --runtime-id (expected current generation $current_id)"
  session=$(echo "$state_json" | jq -r '.tmux_session')
  agentctl_tmux kill-session -t "$session" 2>/dev/null \
    || agentctl_die --code 5 "failed to stop owned tmux session for runtime '$name'"
  echo "stopped"
}

# --- cleanup 処理 -----------------------------------------------------------

cmd_cleanup() {
  local name="" runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for cleanup: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"
  agentctl_with_name_lock "$name" _cleanup_locked "$name" "$runtime_id"
}

_cleanup_locked() {
  local name="$1" runtime_id="$2"
  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    absent) echo "already clean"; return 0 ;;
    running|starting) agentctl_die --code 4 "runtime '$name' is $reconcile; stop it first" ;;
    conflict) agentctl_die --code 4 "runtime '$name' is in conflict state; refusing to auto-remediate (manual inspection required)" ;;
    stale|orphan|exited) : ;;
    *) agentctl_die --code 4 "runtime '$name' is in unrecognized state '$reconcile'; refusing cleanup" ;;
  esac

  local expected_id session
  session=$(agentctl_tmux_session "$name")
  if state_json=$(agentctl_read_state "$name" 2>/dev/null); then
    expected_id=$(echo "$state_json" | jq -r '.runtime_id')
  else
    # orphan: state が無いので tmux marker の runtime_id と照合する。
    expected_id=$(agentctl_tmux_get_marker "${session}" runtime_id)
  fi
  [ -n "$expected_id" ] || agentctl_die --code 3 "cannot determine expected runtime_id for cleanup"
  [ "$runtime_id" = "$expected_id" ] || agentctl_die --code 4 "stale --runtime-id (expected $expected_id)"

  if [ "$reconcile" != "stale" ]; then
    agentctl_tmux kill-session -t "$session" 2>/dev/null \
      || agentctl_die --code 5 "failed to remove owned tmux session during cleanup for runtime '$name'"
  fi
  agentctl_codex_hook_remove_runtime_bindings "$runtime_id"
  rm -rf "$(agentctl_runtime_dir "$name")"
  echo "cleaned"
}

# --- resume 処理 -----------------------------------------------------------

cmd_resume() {
  local name="" cwd="" backend="" policy_file="" from_runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --cwd) require_option_value "$1" "$#"; cwd="$2"; shift 2 ;;
      --backend|--agent) require_option_value "$1" "$#"; backend="$2"; shift 2 ;;
      --policy-file) require_option_value "$1" "$#"; policy_file="$2"; shift 2 ;;
      --from-runtime-id) require_option_value "$1" "$#"; from_runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for resume: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --from-runtime-id "$from_runtime_id"

  # v8 正典構文: resume は predecessor の state.json から cwd/backend を厳密に
  # 継承する (継続 identity は cwd/backend に紐づくため)。--cwd/--agent/
  # --backend の明示指定は usage error とし、上書きを許可しない。
  if [ -n "$cwd" ]; then
    agentctl_die "resume does not accept --cwd; cwd is inherited from the predecessor generation"
  fi
  if [ -n "$backend" ]; then
    agentctl_die "resume does not accept --agent/--backend; backend is inherited from the predecessor generation"
  fi

  local policy_json=""
  if [ -n "$policy_file" ]; then
    policy_json=$(agentctl_validate_policy_file "$policy_file")
  fi

  agentctl_ensure_root
  agentctl_with_name_lock "$name" _resume_locked "$name" "$policy_json" "$from_runtime_id"
}

_resume_locked() {
  local name="$1" policy_json_in="$2" from_runtime_id="$3"

  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    exited|stale) : ;;
    absent) agentctl_die --code 3 "runtime '$name' must be exited/stale to resume (reconcile=absent)" ;;
    *) agentctl_die --code 4 "runtime '$name' must be exited/stale to resume (reconcile=$reconcile)" ;;
  esac

  local state_json predecessor_id
  state_json=$(agentctl_read_state "$name") || agentctl_die --code 3 "no predecessor state for '$name'"
  predecessor_id=$(echo "$state_json" | jq -r '.runtime_id')
  [ "$from_runtime_id" = "$predecessor_id" ] || agentctl_die --code 4 "stale --from-runtime-id (expected predecessor generation $predecessor_id)"

  # cwd/backend は常に predecessor の state.json から継承する (v8 正典構文;
  # caller からの override は cmd_resume 側で既に usage error にしている)。
  local cwd backend
  cwd=$(echo "$state_json" | jq -r '.cwd')
  backend=$(echo "$state_json" | jq -r '.backend')
  [[ "$cwd" == /* ]] || agentctl_die "--cwd must be an absolute path"
  [ -d "$cwd" ] || agentctl_die "--cwd does not exist: $cwd"
  case "$backend" in
    fake|claude|claude-work|codex) : ;;
    *) agentctl_die "unknown backend: $backend" ;;
  esac

  local manifest_json mission_status
  manifest_json=$(agentctl_read_manifest "$name") || agentctl_die --code 3 "no continuation manifest for '$name'; refusing resume"
  mission_status=$(echo "$manifest_json" | jq -r '.mission_status')
  [ "$mission_status" = "running" ] || agentctl_die --code 4 "cannot resume: manifest mission_status='$mission_status' (expected running; use complete for done/blocked/failed)"

  # continuation bundle 用の log tail は前世代 session が生きている間にしか
  # 取れないため、kill する前に採取する。
  local session log_tail
  session=$(agentctl_tmux_session "$name")
  log_tail=$(agentctl_capture_pane_tail "$session" "${AGENTCTL_RESUME_LOG_TAIL_LINES:-500}")

  # exited generation の dead pane は新 generation 公開前に確実に除去する。stale は既に session 不在。
  if [ "$reconcile" = "exited" ]; then
    agentctl_tmux kill-session -t "$session" 2>/dev/null \
      || agentctl_die --code 5 "failed to remove predecessor tmux session before resume for runtime '$name'"
  fi

  # 前世代の policy snapshot/digest は resume が明示的な --policy-file を
  # 渡さない限りそのまま継承する。渡された場合も content-addressed path
  # (agentctl_write_policy_snapshot) へ書くため、前世代の snapshot ファイル
  # 自体は決して上書きせず、predecessor の policy snapshot を immutable に保つ。
  local dir policy_snapshot_path policy_digest old_digest
  dir=$(agentctl_runtime_dir "$name")
  old_digest=$(echo "$state_json" | jq -r '.policy_digest')
  if [ -n "$policy_json_in" ]; then
    {
      IFS= read -r policy_snapshot_path
      IFS= read -r policy_digest
    } < <(agentctl_write_policy_snapshot "$dir" "$policy_json_in")
  else
    policy_snapshot_path=$(echo "$state_json" | jq -r '.policy_snapshot_path')
    policy_digest="$old_digest"
    [ -f "$policy_snapshot_path" ] || agentctl_die --code 4 "predecessor policy snapshot missing: $policy_snapshot_path"
  fi

  # mission.txt は前世代のまま再利用する (resume で上書きしない = 継続 context を保つ)。
  # continuation bundle にはその内容をそのまま埋め込み、1 本のファイル/1 turn
  # として届ける (2 turn に分けると screen-settle だけでは実 backend 上の
  # 衝突を防げないため)。
  local mission_path continuation_path
  mission_path="$dir/mission.txt"
  continuation_path="$dir/continuation.txt"
  agentctl_build_continuation_bundle "$manifest_json" "$log_tail" "$policy_snapshot_path" "$mission_path" "$old_digest" "$policy_digest" \
    | agentctl_atomic_write "$continuation_path" 0600

  _publish_generation "$name" "$cwd" "$backend" "$policy_snapshot_path" "$policy_digest" "$continuation_path" "resume"
}

# --- complete 処理 -----------------------------------------------------------

cmd_complete() {
  local name="" runtime_id=""
  if [ $# -gt 0 ] && [[ "$1" != --* ]]; then
    name="$1"; shift
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) require_option_value "$1" "$#"; name="$2"; shift 2 ;;
      --runtime-id) require_option_value "$1" "$#"; runtime_id="$2"; shift 2 ;;
      *) agentctl_die "unknown option for complete: $1" ;;
    esac
  done
  require_arg --name "$name"
  agentctl_validate_name "$name"
  require_arg --runtime-id "$runtime_id"
  agentctl_with_name_lock "$name" _complete_locked "$name" "$runtime_id"
}

_complete_locked() {
  local name="$1" runtime_id="$2"

  local manifest_json mission_status
  manifest_json=$(agentctl_read_manifest "$name") || agentctl_die --code 3 "no continuation manifest for '$name'; refusing complete"
  mission_status=$(echo "$manifest_json" | jq -r '.mission_status')
  case "$mission_status" in
    done|blocked|failed) : ;;
    *) agentctl_die --code 4 "cannot complete: manifest mission_status='$mission_status' (expected done/blocked/failed)" ;;
  esac

  local reconcile
  reconcile=$(agentctl_reconcile "$name")
  case "$reconcile" in
    absent) echo "already completed (reconcile=$reconcile)"; return 0 ;;
    conflict) agentctl_die --code 4 "runtime '$name' is in conflict state; refusing to auto-remediate (manual inspection required)" ;;
    running|starting|exited|stale|orphan) : ;;
    *) agentctl_die --code 4 "runtime '$name' is in unrecognized state '$reconcile'; refusing complete" ;;
  esac

  local session
  session=$(agentctl_tmux_session "$name")

  # state が無い (orphan) 場合も tmux marker の runtime_id と照合し、
  # caller の runtime_id を素通りさせない (cleanup と同じ fencing pattern)。
  local state_json expected_id
  if state_json=$(agentctl_read_state "$name" 2>/dev/null); then
    expected_id=$(echo "$state_json" | jq -r '.runtime_id')
  else
    expected_id=$(agentctl_tmux_get_marker "$session" runtime_id)
  fi
  [ -n "$expected_id" ] || agentctl_die --code 3 "cannot determine expected runtime_id for complete"
  [ "$runtime_id" = "$expected_id" ] || agentctl_die --code 4 "stale --runtime-id (expected $expected_id)"

  if [ "$reconcile" != "stale" ]; then
    agentctl_tmux kill-session -t "$session" 2>/dev/null \
      || agentctl_die --code 5 "failed to remove owned tmux session while completing runtime '$name'"
  fi
  echo "completed"
}

# --- doctor 処理 -----------------------------------------------------------

cmd_doctor() {
  local json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) agentctl_die "unknown option for doctor: $1" ;;
    esac
  done

  local names=() entries="[]"
  if [ -d "$(agentctl_runtimes_dir)" ]; then
    while IFS= read -r -d '' d; do
      names+=("$(basename "$d")")
    done < <(find "$(agentctl_runtimes_dir)" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
  fi
  # tmux 側に agentctl marker があるが state ディレクトリが無い (orphan) セッションも拾う。
  while IFS= read -r sess; do
    case "$sess" in
      agentctl-*)
        local n="${sess#agentctl-}"
        local already=0
        for existing in "${names[@]}"; do [ "$existing" = "$n" ] && already=1; done
        [ "$already" -eq 1 ] || names+=("$n")
        ;;
    esac
  done < <(agentctl_tmux list-sessions -F '#{session_name}' 2>/dev/null || true)

  for n in "${names[@]}"; do
    local r
    r=$(agentctl_reconcile "$n")
    entries=$(echo "$entries" | jq --arg name "$n" --arg reconcile "$r" '. + [{name:$name, reconcile:$reconcile}]')
  done

  if [ "$json" -eq 1 ]; then
    jq -n --argjson schema_version "$AGENTCTL_SCHEMA_VERSION" --argjson runtimes "$entries" \
      '{schema_version:$schema_version, runtimes:$runtimes}'
  else
    echo "$entries" | jq -r '.[] | "\(.name)\t\(.reconcile)"'
  fi
}

main() {
  local cmd="${1:-}"
  [ -n "$cmd" ] || { usage; exit 2; }
  shift || true
  case "$cmd" in
    start) cmd_start "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    steer) cmd_steer "$@" ;;
    attach) cmd_attach "$@" ;;
    interrupt) cmd_interrupt "$@" ;;
    stop) cmd_stop "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    resume) cmd_resume "$@" ;;
    complete) cmd_complete "$@" ;;
    -h|--help|help) usage ;;
    *) echo "agentctl: unknown command: $cmd" >&2; usage; exit 2 ;;
  esac
}

# source されたとき (unit test が内部関数を直接呼ぶため) は自動実行しない。
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
