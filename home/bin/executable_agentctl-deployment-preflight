#!/bin/bash
# agentctl deployment/rollback interlock。policy guard (dispatcher/classify/
# hooks.json) を再デプロイ・ロールバックする前に、既に稼働中の agentctl
# runtime が存在しないことを検証する。
#
# 使い方: agentctl-deployment-preflight [-- <command> [args...]]
#
# コマンドを渡した場合 (実際の rollback 操作): exclusive deployment lock を
# inventory (稼働中 runtime の有無確認) から <command> (removal/apply/
# postcheck を丸ごと含む実 rollback 操作) の完了まで保持し続ける。preflight
# で確認してから lock を release し、その後に別プロセスが実際の
# removal/apply を行う分離設計だと、release から removal/apply 開始までの
# 間に新規 start/resume が publish されてしまう race window が生まれるため
# (start/resume は shared lock を publication 完了まで保持するので、この
# exclusive 区間が続く限り新規 publish は flock -s でブロックされ割り込めない)。
# 稼働中 runtime が見つかった場合は <command> を一切実行せず exit 1 する。
#
# コマンドを渡さない場合 (read-only query): 稼働中 runtime の有無だけを
# 判定して即座に lock を release する後方互換モード。実際の rollback
# 操作はこのモードの後に別途行わず、必ず上記のコマンド付き呼び出しで
# くるむこと (でなければ inventory と実操作の間に race window が生まれる)。
#
# 稼働中 generation が 1 件でもあれば exit 1 で拒否する (その runtime は
# 古い guard のまま動き続けるため、安全な入れ替えタイミングではない)。
# runtime の stop/kill/cleanup は一切行わない (それは stop/cleanup コマンドの
# 責務であり、rollback が稼働中 runtime を自動で殺すことは絶対にない)。

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck disable=SC1091
source "$SCRIPT_DIR/agentctl-common.sh"

[ "${1:-}" = "--" ] && shift

agentctl_ensure_root
agentctl_acquire_deployment_lock_exclusive

blockers=()
while IFS= read -r sess; do
  case "$sess" in
    agentctl-*) : ;;
    *) continue ;;
  esac
  name="${sess#agentctl-}"
  reconcile=$(agentctl_reconcile "$name")
  # 既知の安全な終了状態のみを許可する allow-list にする (running/starting/
  # orphan/conflict を個別に列挙する block-list だと、将来 agentctl_reconcile
  # に追加される未知の状態が素通りしてしまう fail-open な穴になるため)。
  case "$reconcile" in
    absent|exited|stale) : ;;
    *)
      blockers+=("$name ($reconcile)")
      ;;
  esac
done < <(agentctl_tmux list-sessions -F '#{session_name}' 2>/dev/null || true)

if [ "${#blockers[@]}" -gt 0 ]; then
  agentctl_release_deployment_lock
  echo "agentctl-deployment-preflight: refusing rollback/redeploy, active runtimes found:" >&2
  printf '  - %s\n' "${blockers[@]}" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  agentctl_release_deployment_lock
  echo "agentctl-deployment-preflight: no active agentctl runtimes; safe to redeploy/rollback guard"
  exit 0
fi

echo "agentctl-deployment-preflight: no active agentctl runtimes; running rollback operation under exclusive lock" >&2
set +e
# bash の {fd} 自動割当は close-on-exec が立たない (agentctl_tmux() と同じ理由)。
# <command> が deploy/restart 系で自身を daemonize すると、close せずに exec した
# 場合その子が lock fd を継承し、この script が release した後も flock を
# 永久に保持し続けて以後の全 start/resume (shared lock) を無期限に wedge する。
# サブシェルで自 lock fd を閉じてから <command> を呼ぶことで継承を防ぐ。
(
  agentctl_close_fd_value "$AGENTCTL_DEPLOY_LOCK_FD" || exit 1
  "$@"
)
status=$?
set -e
agentctl_release_deployment_lock
exit "$status"
