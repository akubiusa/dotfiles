# Codex installer などの非対話処理でも利用できるよう、ユーザー用 bin を PATH に追加する
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# 子プロセスの非対話 Bash にも同じ環境初期化を適用する
if [ -z "${BASH_ENV:-}" ] && [ -f "$HOME/.bash_env" ]; then
  export BASH_ENV="$HOME/.bash_env"
fi

# 非対話の login shell でも mise 管理ツールを利用できるよう shims を有効化する
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims)"
elif [ -x "$HOME/.local/bin/mise" ]; then
  eval "$("$HOME/.local/bin/mise" activate bash --shims)"
fi
