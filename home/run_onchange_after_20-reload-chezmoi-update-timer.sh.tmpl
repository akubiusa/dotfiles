{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# user systemd manager が利用可能なら timer を即時反映する。
# service-sha256: {{ include "dot_config/systemd/user/chezmoi-update.service" | sha256sum }}
# timer-sha256: {{ include "dot_config/systemd/user/chezmoi-update.timer" | sha256sum }}
set -euo pipefail

if ! command -v systemctl >/dev/null 2>&1; then
  exit 0
fi

if ! systemctl --user show-environment >/dev/null 2>&1; then
  echo "systemd user manager is unavailable; chezmoi update timer will start with the next user manager session" >&2
  exit 0
fi

systemctl --user daemon-reload
if ! systemctl --user cat chezmoi-update.timer >/dev/null 2>&1; then
  echo "chezmoi update timer is not visible to the current user manager; skipping immediate start" >&2
  exit 0
fi
systemctl --user start chezmoi-update.timer
{{- end }}
